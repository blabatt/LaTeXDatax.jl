layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="src" cwd="./src" {
		floating_panes {
			pane name="terminal" {
				x "25%"
				y "25%"
				width "50%"
				height "50%"
			}
		}
		pane split_direction="vertical" {
			command "nvim"
			args "LaTeXDatax.jl"
		}
    }
    tab name="env" cwd="." {
		pane split_direction="vertical" {
			pane name="julia" command="julia" size="60%"
			pane name="env" {
				command "nvim"
				args  "layout.kdl" ".gitignore" ".JuliaFormatter.toml"
			}
		}
	}
    tab name="test" cwd="./test" {
		pane split_direction="vertical" {
			command "nvim"
			args "runtests.jl"
		}
    }
}

